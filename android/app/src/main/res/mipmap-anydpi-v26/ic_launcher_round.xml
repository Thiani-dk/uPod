<?xml version="1.0" encoding="utf-8"?>
<!-- No inset on either layer: @capacitor/assets emits inset="16.7%" on
     both, which shrinks the *background* to the safe zone and leaves the
     mask's corners transparent. The background must fill the full 108dp
     canvas; the foreground carries its own padding instead (see
     scripts/generate-brand-assets.mjs, where the mark is drawn at 40% of
     the canvas — comfortably inside the 72dp safe circle). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
