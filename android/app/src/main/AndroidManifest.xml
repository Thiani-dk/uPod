<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Media-session foreground service (@capgo/capacitor-media-session).
         The plugin's manifest fragment merges in FOREGROUND_SERVICE, but on
         Android 14+ (API 34+) any FGS declaring foregroundServiceType
         "mediaPlayback" ALSO needs this type-specific permission in the
         app's own manifest — without it MediaSessionService.connectAndInitialize
         throws SecurityException and playback crashes. Both are listed
         explicitly here so it doesn't depend on library merge order. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 13+ (API 33+): without this, the foreground service's
         notification above (and the lock-screen/notification-shade
         controls riding on it) may simply never show. Requested at
         runtime via NotificationPermissionPlugin — see
         src/utils/notificationPermission.js. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Held only while state.playing is true (PlaybackWakeLockPlugin),
         as cheap insurance against the CPU suspending mid-decode with the
         screen off — mirrors ExoPlayer's C.WAKE_MODE_LOCAL in mature
         native players, regardless of whether Chromium's own WebView
         media pipeline already handles this adequately on its own. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Declared so "All files access" appears as a manual toggle in
         Settings → Apps → uPod → Permissions, in case scoped storage
         blocks raw reads to a shared folder like Download on Android 11+.
         Not requested at runtime — the app doesn't launch any special intent for it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
</manifest>
