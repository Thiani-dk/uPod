<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Puts uPod in the system share sheet, so a track heard in
                 the YouTube/Instagram app can be sent here with Share >
                 uPod. This plain ACTION_SEND + text/plain filter is the
                 whole mechanism — it is exactly what Snaptube registers
                 (one .activity.ActionSendDispatchActivity, same action,
                 same category, same type). CATEGORY_DEFAULT is required:
                 without it the filter is never considered for the
                 implicit intent the share sheet sends.
                 The URL is read off the intent by ShareTargetPlugin. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Keeps the process alive while yt-dlp works. An album is
             minutes of downloading and the user is going to leave the
             app, at which point a process with no visible activity is
             the first thing Android reclaims. stopWithTask="false" so
             swiping uPod out of Recents doesn't take a download with
             it. See DownloadForegroundService.java. -->
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Media-session foreground service (@capgo/capacitor-media-session).
         The plugin's manifest fragment merges in FOREGROUND_SERVICE, but on
         Android 14+ (API 34+) any FGS declaring foregroundServiceType
         "mediaPlayback" ALSO needs this type-specific permission in the
         app's own manifest — without it MediaSessionService.connectAndInitialize
         throws SecurityException and playback crashes. Both are listed
         explicitly here so it doesn't depend on library merge order. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 14+ (API 34+) requires the type-specific permission for
         every foregroundServiceType an app declares, exactly as above:
         "dataSync" is the category a download the user asked for falls
         under, and without this the promotion throws instead of
         protecting the download. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ (API 33+): without this, the foreground service's
         notification above (and the lock-screen/notification-shade
         controls riding on it) may simply never show. Requested at
         runtime via NotificationPermissionPlugin — see
         src/utils/notificationPermission.js. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Held only while state.playing is true (PlaybackWakeLockPlugin),
         as cheap insurance against the CPU suspending mid-decode with the
         screen off — mirrors ExoPlayer's C.WAKE_MODE_LOCAL in mature
         native players, regardless of whether Chromium's own WebView
         media pipeline already handles this adequately on its own. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Declared so "All files access" appears as a manual toggle in
         Settings → Apps → uPod → Permissions, in case scoped storage
         blocks raw reads to a shared folder like Download on Android 11+.
         Not requested at runtime — the app doesn't launch any special intent for it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
</manifest>
