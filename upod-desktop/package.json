{
  "name": "upod-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop uPod — the same app as the phone, running on the laptop.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "node scripts/fetch-ytdlp.mjs",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5180 && electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "sync-phone": "bash scripts/sync-from-phone.sh"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "ffmpeg-static": "^5.2.0",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "vite": "^8.2.0",
    "wait-on": "^8.0.1"
  }
}
